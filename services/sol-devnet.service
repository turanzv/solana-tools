[Unit]
Description=Solana Devnet Validator
After=network.target

[Service]
Type=simple
User=ubuntu
LimitNOFILE=1000000
LogRateLimitIntervalSec=0
Environment="PATH=/bin:/usr/bin:/home/ubuntu/agave/bin"
ExecStart=/home/ubuntu/bin/run-validator.sh devnet # --clear-ledger
TimeoutStopSec=10s
KillMode=control-group
# ExecStartPost=/bin/sleep 10
# ExecStartPost=/home/ubuntu/agave/bin/agave-validator set-log-filter 'solana_program_runtime=info'
RuntimeMaxSec=3600

[Install]
WantedBy=default.target
